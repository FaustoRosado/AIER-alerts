# Logs
*.log
logs/
*.log.*

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.cache

# Backup files
*.backup
*.old
*.orig

# Compiled files
*.com
*.class
*.dll
*.exe
*.o
*.so

# Archives
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# ==============================================================================
# DOCKER
# ==============================================================================

# Docker
.dockerignore
docker-compose.override.yml

# ==============================================================================
# KEEP THESE FILES
# ==============================================================================

# Important: Keep documentation
!README.md
!**/README.md
!docs/**/*.md
!docs/**/*.txt

# Sprint 3: Ignore all .md except README.md and demo_guide.md
tech-execution/sprint3/*.md
!tech-execution/sprint3/README.md
!tech-execution/sprint3/demo_guide.md

# Keep configuration files
!.gitignore
!.gitkeep
!package.json
!tsconfig.json
!requirements.txt
!*.tf
!*.sh
!*.ps1

# Keep scripts
!scripts/**/*.py
!scripts/**/*.sh
!scripts/**/*.ps1

# Sprint 4: Local setup files (not public-facing)
tech-execution/ai-siem-infra/local-setup/
tech-execution/ai-siem-infra/check-dependencies.sh
tech-execution/ai-siem-infra/install-dependencies.sh
tech-execution/ai-siem-infra/INSTALL_CHECK.md
tech-execution/ai-siem-infra/DEPENDENCIES_STATUS.md
tech-execution/ai-siem-infra/SPRINT4_EXECUTION_PLAN.md
tech-execution/ai-siem-infra/START_HERE.md
tech-execution/ai-siem-infra/tailscale-relay/CONNECT.md
tech-execution/ai-siem-infra/tailscale-relay/SSM_SETUP.md
tech-execution/ai-siem-infra/cleanup-aws.sh

