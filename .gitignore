# AIER Capstone Project - Root .gitignore
# This applies to the entire capstone project directory

# ==============================================================================
# SENSITIVE INFORMATION - CRITICAL
# ==============================================================================

# AWS Credentials and Keys
*.pem
*.key
*.p12
*.pfx
.aws/
credentials
config
aws-exports.js

# Secrets and API Keys
*.secret
secrets.json
secrets.yaml
secrets.yml
.env
.env.local
.env.production
.env.*.local
kaggle.json

# SSH Keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ==============================================================================
# TERRAFORM STATE FILES - NEVER COMMIT
# ==============================================================================

# State files contain infrastructure details and potential secrets
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Terraform variable files may contain sensitive data
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plans may expose infrastructure details
*.tfplan
*.tfplan.json

# Terraform directories
.terraform/
.terraform.lock.hcl

# ==============================================================================
# OPERATING SYSTEM FILES
# ==============================================================================

# macOS
.DS_Store
.DS_Store?
._*
**/._*
**/._.DS_Store
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
.localized
.VolumeIcon.icns

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==============================================================================
# IDE AND EDITOR FILES
# ==============================================================================

# Visual Studio Code
.vscode/
.vscode-test/
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*.swn
*~
Session.vim

# Emacs
*~
\#*\#
.\#*

