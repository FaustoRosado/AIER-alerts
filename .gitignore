# ==============================================================================
# PROJECT-SPECIFIC
# ==============================================================================

# Data files (Kaggle datasets)
data_viz/data/*.csv
data_viz/data/*.json
!data_viz/data/.gitkeep

# Sprint 4 AI SIEM - Local guides only
tech-execution/ai-siem-infra/IMPLEMENTATION.md
tech-execution/ai-siem-infra/*/IMPLEMENTATION.md
tech-execution/ai-siem-infra/QUICK_START.md
tech-execution/ai-siem-infra/SUMMARY.md
tech-execution/ai-siem-infra/SCREENSHOT_CHECKLIST.md
tech-execution/ai-siem-infra/GIT_WORKFLOW.md
tech-execution/ai-siem-infra/STATUS.md
tech-execution/ai-siem-infra/DEPENDENCIES_STATUS.md
tech-execution/ai-siem-infra/INSTALL_CHECK.md
